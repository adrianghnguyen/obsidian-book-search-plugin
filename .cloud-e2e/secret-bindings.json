{
  "pluginId": "obsidian-book-search-plugin",
  "repo": "obsidian-book-search-plugin",
  "note": "Project Cloud environment secret name is book_search_gcp (Google Books API key). Also accept GOOGLE_BOOKS_API_KEY. Never log values; inject length-only.",
  "bindings": [
    {
      "cursorEnv": "book_search_gcp",
      "secretStorageId": "obsidian-book-search-api-key",
      "read": "BookSearchPlugin.hydrateSecrets → settings.apiKey → GoogleBooksApi key query param",
      "pointer": null
    },
    {
      "cursorEnv": "GOOGLE_BOOKS_API_KEY",
      "secretStorageId": "obsidian-book-search-api-key",
      "read": "Alias for book_search_gcp when that env name is used instead",
      "pointer": null
    },
    {
      "cursorEnv": "NAVER_CLIENT_ID",
      "secretStorageId": "obsidian-book-search-naver-client-id",
      "read": "BookSearchPlugin.hydrateSecrets → settings.naverClientId → NaverBooksApi X-Naver-Client-Id",
      "pointer": null
    },
    {
      "cursorEnv": "NAVER_CLIENT_SECRET",
      "secretStorageId": "obsidian-book-search-naver-client-secret",
      "read": "BookSearchPlugin.hydrateSecrets → settings.naverClientSecret → NaverBooksApi X-Naver-Client-Secret",
      "pointer": null
    }
  ]
}
